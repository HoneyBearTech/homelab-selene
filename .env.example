# Settings for one homelab-selene installation. Copy to .env and restrict it (cp .env.example .env &&
# chmod 600 .env); .env is gitignored and never committed. Every setting the stack reads is listed here and in
# docs/interfaces.md.
#
# No secrets belong in this file. USAS keeps its password hash, passkeys, Vault, Vault password, SSH key and status
# token in its data (under CONFIG_ROOT).

# Time zone for logs and schedules (a tz database name).
TZ=Etc/UTC

# Host directory holding every service's data, one folder per service: USAS's in CONFIG_ROOT/usas/config. A
# directory of your own, never inside /var/lib/docker/volumes: `docker volume prune` would delete it
# (docs/installing.md). It holds every secret USAS has: CONFIG_ROOT/usas/config must belong to uid and gid 10001
# (which USAS runs as) with mode 0700. Back it up (scripts/backup.sh does), encrypted when it leaves the host.
CONFIG_ROOT=/srv/config

# The host address USAS's port 8080 is published on: the one the reverse proxy reaches. The firewall lets only the
# proxy in (docs/installing.md#the-firewall).
USAS_BIND_ADDRESS=192.0.2.20

# The HTTPS address USAS is opened at, through the reverse proxy (https://host, with :port if it isn't 443).
# Passkeys belong to this host name: registering them again is needed when it changes.
USAS_PUBLIC_URL=https://usas.example.com

# The reverse proxy's address (comma-separated if several): USAS believes the X-Forwarded-Proto and
# X-Forwarded-For headers only from it.
USAS_TRUSTED_PROXIES=192.0.2.10
