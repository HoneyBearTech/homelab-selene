# Optional: settings for the unattended backup (scripts/scheduled-backup.sh). Copy to backup.env and restrict it
# (cp backup.env.example backup.env && chmod 600 backup.env); backup.env is gitignored and never committed: the
# push URL is a secret, since anyone who has it can report to the monitor. Every setting is optional.

# Where backups are written, and how many of them are kept there (the newest).
BACKUP_DIR=backups
BACKUP_KEEP=3

# Where each backup is copied with rsync, usually over SSH to an alias in ~/.ssh/config that names the backup
# server, its user and a key used only for this. Empty = no copy off the host.
BACKUP_REMOTE=
# How many backups are kept there (the newest).
BACKUP_REMOTE_KEEP=30

# An age public key (age1...). The key pair is made on another machine (age-keygen -o selene-backup.key), and the
# private key never comes to this host. When set, the copy off the host is one archive of the backup encrypted to
# that key (backup.tar.age, with its SHA256SUMS), so the backup server never holds USAS's secrets in the clear;
# age -d -i <private key> backup.tar.age | tar -x turns it back into the backup (docs/rebuilding.md). Needs age on
# this host (sudo apt install age). Empty = the backup is copied as it is.
BACKUP_AGE_RECIPIENT=

# The backup stops USAS while its data is copied, which would end a playbook run in progress, so it waits while a run
# goes on (a web UI run, or ansible-playbook started in the container): it looks again every BACKUP_BUSY_INTERVAL
# seconds, and after BACKUP_BUSY_TIMEOUT seconds it gives up and fails (the push monitor hears "down") without
# stopping anything. 0 = don't wait.
BACKUP_BUSY_TIMEOUT=14400
BACKUP_BUSY_INTERVAL=60

# An Uptime Kuma push monitor's URL (Add New Monitor -> Push), told "up" after each good run and "down" after a
# failed one. Set its heartbeat interval a little longer than the schedule (such as 25 hours for a nightly backup),
# so it also alerts when no backup runs at all. Empty = no reports.
BACKUP_PING_URL=
